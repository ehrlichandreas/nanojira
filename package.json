{
  "name": "nanojira",
  "private": true,
  "type": "module",
  "version": "4.3.0",
  "description": "NanoJira: a local, file-based task tool for agents.",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "nanojira": "dist/nanojira.mjs",
    "nanojira-mcp": "dist/nanojira-mcp.mjs"
  },
  "scripts": {
    "build": "node tools/bundle.ts",
    "build:check": "node tools/bundle.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "node tools/bundle.ts --check && node test/run-all.ts",
    "perf": "node tools/bundle.ts --check && node tools/perf.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "git-history-tools": "github:ehrlichandreas/git-history-tools#v0.4.4",
    "typescript": "^5.6.0"
  }
}
