{
  "name": "nanojira",
  "private": true,
  "type": "module",
  "version": "4.0.0",
  "description": "NanoJira: a local, file-based task tool for agents.",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "nanojira": "dist/nanojira.mjs",
    "nanojira-mcp": "dist/nanojira-mcp.mjs"
  },
  "scripts": {
    "build": "node tools/bundle.mjs",
    "build:check": "node tools/bundle.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node tools/bundle.mjs --check && node test/run-all.mjs",
    "perf": "node tools/bundle.mjs --check && node tools/perf.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
