{
  "name": "nanojira",
  "private": true,
  "version": "3.12.2",
  "description": "NanoJira: a local, file-based task tool for agents.",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "nj": "dist/nj.mjs",
    "nj-mcp": "dist/nj-mcp.mjs"
  },
  "scripts": {
    "build": "node tools/bundle.js",
    "build:check": "node tools/bundle.js --check",
    "typecheck": "tsc --noEmit",
    "test": "node tools/bundle.js --check && node test/run-all.js",
    "perf": "node tools/bundle.js --check && node tools/perf.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
