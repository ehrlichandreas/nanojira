{
  "name": "nanojira",
  "private": true,
  "description": "NanoJira: a local, file-based task tool for agents.",
  "bin": {
    "nj": "dist/nj"
  },
  "scripts": {
    "build": "node tools/bundle.js",
    "build:check": "node tools/bundle.js --check",
    "typecheck": "tsc --noEmit",
    "test": "node tools/bundle.js --check && node test/run-all.js dist/nj",
    "perf": "node tools/bundle.js --check && node tools/perf.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
