#!/bin/sh
# Generated by tools/bundle.ts -- do not edit.
# Parameter expansion and a loop over the lines instead of basename/dirname/
# sed: one subshell and the `node --version` probe are the only processes
# before the exec, and nothing is written (no here-document, which bash < 5.1
# and zsh back with a temp file) (DECISIONS 213).
case $0 in
  */*) name=${0##*/}; d=${0%/*}; [ -n "$d" ] || d=/ ;;
  *) name=$0; d=. ;;
esac
dir=$(CDPATH='' cd -P -- "$d" >/dev/null 2>&1 && pwd -P) || {
  echo "$name: cannot resolve the directory of $0" >&2
  exit 127
}
node=${NJ_NODE:-node}
if ! command -v "$node" >/dev/null 2>&1; then
  echo "$name: node not found (looked for '$node')" >&2
  exit 127
fi
version=$("$node" --version 2>/dev/null)
# What `sed -n 's/^v\([0-9][0-9]*\)\..*/\1/p'` printed: the digits of every
# line that starts with v<digits>. -- one per line, quirks included.
major=
nl='
'
set -f; IFS=$nl
for line in $version; do
  rest=${line#v}
  [ "$rest" != "$line" ] || continue
  digits=${rest%%[!0-9]*}
  [ -n "$digits" ] || continue
  case ${rest#"$digits"} in
    .*) major=${major:+$major
}$digits ;;
  esac
done
unset IFS; set +f
if [ -z "$major" ] || [ "$major" -lt 24 ] 2>/dev/null; then
  echo "$name: node too old (requires Node.js >= 24)" >&2
  exit 127
fi
unset NODE_OPTIONS
entry="$dir/../dist/$name.mjs"
if [ ! -f "$entry" ]; then
  echo "$name: $entry not found" >&2
  exit 127
fi
exec "$node" "$entry" "$@"
